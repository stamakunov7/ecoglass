# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key — https://resend.com/api-keys
# Without it, leads are only printed to the dev server console (and fail in production).
RESEND_API_KEY=

# Where website leads are delivered (comma-separate several addresses).
LEAD_TO_EMAIL=info@vk-ecoglass.com

# Sender address. Must be on a domain verified in Resend (e.g. quotes@ecoglass.us).
# Until a domain is verified, Resend only delivers mail from onboarding@resend.dev
# to the email address that owns the Resend account.
LEAD_FROM_EMAIL=EcoGlass Website <onboarding@resend.dev>
