# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key — https://resend.com/api-keys
# Without it, leads are only printed to the dev server console (and fail in production).
RESEND_API_KEY=

# Where website leads are delivered (comma-separate several addresses).
LEAD_TO_EMAIL=info@vk-ecoglass.com

# Sender address. Must be on a domain verified in Resend (e.g. quotes@ecoglass.us).
# Until a domain is verified, Resend only delivers mail from onboarding@resend.dev
# to the email address that owns the Resend account.
LEAD_FROM_EMAIL=EcoGlass Website <onboarding@resend.dev>

# --- Paid social / ads pixels ---
# Each tag loads only when its ID is set (and the visitor has accepted cookies).
# Leave blank until the client provides live IDs.

# Meta (Facebook/Instagram) Pixel ID — numeric, from Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID — from TikTok Ads Manager
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads account ID (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion label for generate_lead / form submit (the part after AW-XXXXX/)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
